# Copy this template to an access-controlled location outside the API checkout.
# Use one dedicated SQL login per human reviewer; never reuse DB_USER.
SQL_SERVER=127.0.0.1
SQL_PORT=1433
SQL_DATABASE=mutelab
MEMBER_DATA_KEY=replace-with-the-same-random-64-character-member-key-used-for-encryption
COMMITTEE_APPROVER_DB_USER=replace-with-a-reviewer-specific-sql-user
COMMITTEE_APPROVER_DB_PASSWORD=replace-with-a-reviewer-specific-sql-password
