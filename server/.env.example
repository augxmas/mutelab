HOST=0.0.0.0
PORT=3100
JWT_SECRET=replace-with-a-long-random-secret-before-starting
DEMO_LOGIN=false
EMAIL_CODE_SECRET=replace-with-another-long-random-secret
EMAIL_CODE_TTL_MINUTES=10
EMAIL_FROM=no-reply@mutelab.kr
SENDMAIL_PATH=/usr/sbin/sendmail
COMMITTEE_PDF_FONT=C:/Windows/Fonts/malgun.ttf
SQL_SERVER=127.0.0.1
SQL_PORT=1433
SQL_DATABASE=mutelab
DB_USER=mutelab
DB_PASSWORD=replace-with-local-sql-password
MEMBER_DATA_KEY=replace-with-a-random-64-character-secret
# Committee approval credentials must never be present in the API environment.
# Use .env.committee-review.example only as a template for a separately protected review environment.

# Apartment public-data daily migration (used by ../apt_collector)
DATA_GO_KR_SERVICE_KEY=replace-with-data-go-kr-service-key
APT_LIST_PAGE_SIZE=500
APT_LIST_DAILY_REQUEST_LIMIT=5000
APT_BASIS_DAILY_REQUEST_LIMIT=5000
APT_LIST_REQUEST_DELAY_MS=200
APT_DETAIL_REQUEST_DELAY_MS=1250
APT_DETAIL_REFRESH_DAYS=30
APT_NO_DATA_RETRY_DAYS=7
APT_FAILED_RETRY_MINUTES=60
APT_HTTP_RETRIES=3
